{
  "name": "marketfa-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "engines": { "node": ">=24.22.1 <25", "pnpm": ">=12.7.0 <13" },
  "scripts": {
    "dev:api": "pnpm --filter @marketfa/api start:dev",
    "dev:web": "pnpm --filter @marketfa/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.0",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  }
}